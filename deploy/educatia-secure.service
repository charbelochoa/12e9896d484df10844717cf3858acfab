[Unit]
Description=EducatIA Secure Campus Service (loopback)
After=network.target

[Service]
Type=simple
User=educatia-lab
Group=educatia-lab
WorkingDirectory=/opt/educatia-secure
ExecStart=/usr/bin/python3 -m app.server --host 127.0.0.1 --port 8088 --internal-port 8099 --data /var/lib/educatia-secure
Restart=on-failure
RestartSec=5
StateDirectory=educatia-secure
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
MemoryMax=512M
TasksMax=256
UMask=0022

[Install]
WantedBy=multi-user.target
